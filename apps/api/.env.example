# Salin ke apps/api/.env (lokal) atau isi sebagai secret di host (HF Space). JANGAN commit nilai asli.

# --- Database ---------------------------------------------------------------------------
# Kosong = SQLite di MALAS_OUTPUT_DIR (mode lokal). Produksi: Neon Postgres.
# URL POOLED (host berakhiran -pooler) untuk aplikasi:
DATABASE_URL=
# URL DIRECT (tanpa -pooler) khusus migrasi skema saat server naik (opsional tapi disarankan di Neon):
DATABASE_URL_DIRECT=

# --- Key BYOK tersimpan (opsional) --------------------------------------------------------
# Rahasia server >= 32 karakter acak: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Tanpa ini fitur "simpan API key" mati. JANGAN ganti sembarangan: key tersimpan jadi tak terbaca.
# Rotasi: pasang yang baru di MALAS_SECRET_KEY dan yang lama (koma) di MALAS_SECRET_KEY_OLD.
MALAS_SECRET_KEY=
MALAS_SECRET_KEY_OLD=
# Key tersimpan yang tak dipakai selama N hari dihapus otomatis (default 90; 0 = mati).
# Penyimpanan key hanya aktif bila login Clerk aktif (atau server lokal, bukan mode hosting).
MALAS_KEY_TTL_DAYS=90
# Webhook Clerk "user.deleted" -> hapus semua data pengguna itu (job, berkas, key, logo).
# Dashboard Clerk -> Webhooks -> endpoint https://<situs>/api/webhooks/clerk, event user.deleted; salin Signing Secret (whsec_...).
CLERK_WEBHOOK_SECRET=

# --- Login (Clerk) --------------------------------------------------------------------------
# Isi salah satu agar login WAJIB di semua /api/* (kecuali /api/config). Kosong = mode anonim (cookie acak).
# Issuer = "Frontend API URL" instance Clerk (Dashboard > API keys), mis. https://xxxx.clerk.accounts.dev
CLERK_ISSUER=
# Bila JWKS ada di alamat lain (default: <issuer>/.well-known/jwks.json):
CLERK_JWKS_URL=
# Origin web yang boleh (klaim azp), koma: https://malas.netlify.app,http://localhost:5173
CLERK_AUTHORIZED_PARTIES=
# 1 = server menolak start bila Clerk belum dikonfigurasi (disarankan di produksi)
MALAS_AUTH_REQUIRED=0

# --- Kuota ----------------------------------------------------------------------------------
# Maks makalah NYATA per pengguna per hari (Mode uji dan 'lanjutkan' tidak dihitung; dibatalkan sebelum jalan = kembali). 0 = tanpa batas.
MALAS_DAILY_QUOTA=0
MALAS_QUOTA_TZ=Asia/Jakarta

# --- Mode hosting -------------------------------------------------------------------------
MALAS_WEB_REQUIRE_KEY=1
MALAS_WEB_RETENTION_HOURS=48
MALAS_WEB_MAX_QUEUE=5

# --- File hasil di Cloudflare R2 (opsional) ---------------------------------------------------
# Keempatnya diisi semua = .docx disimpan di bucket R2 (privat), bukan di database. Kosong semua = bytea di database.
# Endpoint: https://<account_id>.r2.cloudflarestorage.com ; buat API token R2 dengan izin Object Read & Write pada bucket itu saja.
R2_ENDPOINT_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
